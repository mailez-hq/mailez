# syntax=docker/dockerfile-upstream:1.4.3

# Tagged build (-tags mailez_ee) of the control plane. Private tree only;
# never exported to the public source mirror (the public tree ships
# backend/Dockerfile alone).

FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0 GOPROXY=https://goproxy.io,https://proxy.golang.com.cn,direct
WORKDIR /src
COPY . .
# Vendor verification keys (base64 DER SubjectPublicKeyInfo; `license
# genkey` prints a pair — the service key shares it). Official release
# builds MUST inject them via docker-bake.ee.hcl (repo secrets in release
# CI). Empty keeps the source-default dev key, which the server refuses to
# enforce licensing on (MAILEZ_LICENSE_REQUIRED=true fails at startup, see
# internal/ee/license.Load).
ARG MAILEZ_LICENSE_PUBKEY=""
ARG MAILEZ_SERVICE_PUBKEY=""
# -X is a linker flag: it must travel inside -ldflags as ONE argument.
# (The unquoted expansion below used to hand "-X pkg=key" straight to
# `go build`, which rejected it — the path had simply never been
# exercised with a real key before.)
RUN LDFLAGS=""; \
    [ -n "$MAILEZ_LICENSE_PUBKEY" ] && LDFLAGS="$LDFLAGS -X mailez/backend/internal/ee/license.publicKeyB64=$MAILEZ_LICENSE_PUBKEY"; \
    [ -n "$MAILEZ_SERVICE_PUBKEY" ] && LDFLAGS="$LDFLAGS -X mailez/backend/internal/entitlements.publicKeyB64=$MAILEZ_SERVICE_PUBKEY"; \
    go build -tags mailez_ee -ldflags "$LDFLAGS" -o /out/mailez ./cmd/server \
 && go build -tags mailez_ee -ldflags "$LDFLAGS" -o /out/mailez-seed ./cmd/seed

FROM alpine:3.21
RUN adduser -S -u 1000 mailez
COPY --from=build /out/mailez /usr/local/bin/mailez
# One-shot admin provisioning for fresh deployments:
#   docker compose exec backend mailez-seed
COPY --from=build /out/mailez-seed /usr/local/bin/mailez-seed
USER mailez
EXPOSE 8081
ENTRYPOINT ["mailez"]
