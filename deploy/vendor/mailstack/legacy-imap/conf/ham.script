#!/bin/bash
RSPAMD_HOST="$(getent hosts {{ MAIL_FILTER_ADDRESS }}|cut -d\  -f1):11334"
if [[ $? -ne 0 ]]
then
	echo "Failed to lookup {{ MAIL_FILTER_ADDRESS }}" >&2
	exit 1
fi

tee >(rspamc -t 3 -h $RSPAMD_HOST -P mailez learn_ham /dev/stdin||true) \
       >(rspamc -t 3 -h $RSPAMD_HOST -P mailez -f 11 fuzzy_del /dev/stdin||true) \
       >(rspamc -t 3 -h $RSPAMD_HOST -P mailez -f 13 fuzzy_add /dev/stdin||true) > /dev/null

wait
