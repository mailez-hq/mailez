# Shared environment for the mailez mail images (gateway / mailezine / macro-scanner)
# and the mailezine engine. The mailez backend is the control plane: the
# images call its internal API at http://MAILEZ_BACKEND_ADDRESS:8080.
# The images hardcode port 8080, so the backend must listen on 8080 inside the
# docker network (the published host port is mapped separately in
# docker-compose.yml).

# --- control plane wiring ---
MAILEZ_BACKEND_ADDRESS=backend
# TokenEnc / 外部账号密码的加密密钥(16 字节)。生产部署必须更换:
#   openssl rand -hex 16
MAILEZ_SECRET_KEY=change-me-please-16-bytes

# --- 内部 /stack API 共享密钥(企业档必填) ---
# mailezine 引擎与 backend 之间的内部回调(认证/目录/DKIM vault/外部账号
# 密码读取)走共享密钥鉴权。两行必须同值;留空 = 不鉴权(仅限本地开发,
# 同网络任何容器都能读取 DKIM 私钥与外部邮箱明文密码)。
# 同值还充当引擎管理 API(8090)的 Bearer secret:backend 删除用户时经
# MAIL_ENGINE_MGMT_SECRET 级联清除引擎侧邮箱数据(docker-compose.enterprise.yml
# 引用 MAILEZ_STACK_SECRET,无需重复设置)。
# 生成:openssl rand -hex 32
MAILEZ_STACK_SECRET=
MAILEZINE_STACK_SECRET=

# --- release image tag ---
# Compose pulls mailez/*:<MAILEZ_IMAGE_TAG>; the default "local" matches
# locally built images, release deployments set e.g. v1.0.0-rc.1.
MAILEZ_IMAGE_TAG=local
MAILEZ_SUBNET6=

# --- identity ---
MAILEZ_DOMAIN=example.com
MAILEZ_HOSTNAMES=mail.example.com
MAILEZ_POSTMASTER=postmaster
TZ=Etc/UTC
COMPOSE_PROJECT_NAME=mailez

# --- docker 网络 ---
# 邮件栈 compose 使用固定私有网段（受信网段：引擎 TRUSTED_NETS 与
# gateway 代理信任共用）。默认 192.168.206.0/24，
# 如需改网段，必须同时导出同名变量给 compose 插值：
#   $env:MAILEZ_SUBNET = "10.20.30.0/24"
# 容器间一律走服务名（Docker DNS），不再依赖固定容器 IP。
MAILEZ_SUBNET=192.168.206.0/24

# --- TLS ---
# off: plaintext only (local dev)
# cert: provide cert.pem / key.pem in ./certs (see deploy/certs/README.md)
# letsencrypt: automated ACME (needs exposed 80/443)
MAILEZ_TLS=off
# MAILEZ_TLS_CERT_FILE=cert.pem
# MAILEZ_TLS_KEY_FILE=key.pem
MAILEZ_TLS_PORTS=80,443

# --- features ---
MAILEZ_API=true
MAILEZ_ANTIVIRUS=none
MAILEZ_SCAN_MACROS=false
MAILEZ_GREYLISTING=false

# --- mail routing ---
MAILEZ_MESSAGE_SIZE_LIMIT=50000000
MAILEZ_MESSAGE_RATELIMIT=200
MAILEZ_RELAYNETS=
MAILEZ_RELAYHOST=
MAILEZ_RECIPIENT_DELIMITER=+
MAILEZ_REJECT_UNLISTED_RECIPIENT=no

# --- DKIM / full-text search ---
MAILEZ_DKIM_SELECTOR=dkim
MAILEZ_FTS=en

# --- enterprise license (企业版授权) ---
# 未配置时以开发版运行（不限邮箱数）。配置后必须通过签名校验；
# 生产环境建议同时打开 MAILEZ_LICENSE_REQUIRED=true，缺失/无效即拒绝启动。
# 授权文件由 Mailez HQ 签发（cmd/license），内含 edition/max_mailboxes/expiry。
# MAILEZ_LICENSE_FILE=/etc/mailez/license.lic
# MAILEZ_LICENSE_REQUIRED=false

# --- 技术服务（按年订阅，社区版/企业版均可单独购买） ---
# 与软件授权解耦：服务证书只代表支持/SLA/护航权益，不锁定软件功能。
# 由 Mailez HQ 签发（cmd/license service issue），含 tier 与到期日。
# MAILEZ_SERVICE_FILE=/etc/mailez/service.lic

# --- misc ---
LOG_LEVEL=info
# MAILEZ_RESOLVER_ADDRESS is intentionally unset: the nginx gateway resolves
# its upstreams (backend, mail-filter, mailezine) via Docker's embedded
# DNS (127.0.0.11). Pointing it at the unbound container would make those
# lookups NXDOMAIN. The unbound container (service name "resolver") remains
# available for components that opt into it via their own DNS config.

# ManageSieve endpoint used by the webmail filter editor (the mailezine
# engine's ManageSieve port; authenticated with the per-session temp token)
MAIL_SIEVE_ADDR=mailezine:4190

# --- 社区版内置基础反垃圾（引擎 internal/junk；企业版配 Rspamd 后自动让位） ---
# MAILEZINE_JUNK_ENABLED=true
# MAILEZINE_JUNK_HEADER_SCORE=4.5
# MAILEZINE_JUNK_REJECT_SCORE=12
# MAILEZINE_JUNK_RBLS=bl.spamcop.net
# MAILEZINE_JUNK_WHITELIST=partner.example,boss@corp.example
# MAILEZINE_JUNK_BLACKLIST=@spam.example
# MAILEZINE_JUNK_GREYLIST=false