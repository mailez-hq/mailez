# Shared environment for the the mail-stack reference mail-stack images (front/postfix/dovecot/
# rspamd/unbound). The mailez backend replaces the mail-stack reference's admin container, so
# the images reach the control-plane internal API at http://BACKEND_ADDRESS:8080
# -- the the mail-stack reference images hardcode port 8080, hence the backend must listen on
# 8080 inside the docker network (the published host port is mapped separately
# in docker-compose.yml).

# --- control plane wiring ---
BACKEND_ADDRESS=backend
ADMIN_PORT=8080
SECRET_KEY=change-me-please-16-bytes
SUBNET=192.168.206.0/24
PERMIT_IPV4_NETWORKS=192.168.206.0/24
PERMIT_IPV6_NETWORKS=

# --- identity ---
DOMAIN=example.com
HOSTNAMES=mail.example.com
POSTMASTER=postmaster
TZ=Etc/UTC
COMPOSE_PROJECT_NAME=mailez

# --- TLS ---
# notls: plaintext only (local dev)
# cert:  provide cert.pem / key.pem in ./certs (see deploy/certs/README.md)
# letsencrypt / mail-letsencrypt: automated ACME (needs exposed 80/443)
TLS_FLAVOR=notls
# TLS_CERT_FILENAME=cert.pem
# TLS_KEYPAIR_FILENAME=key.pem
WEBROOT_REDIRECT=

# --- web surfaces: served by the mailez frontends later; none yet ---
ADMIN=false
WEBMAIL=none
API=true
WEBDAV=none
ANTIVIRUS=none
SCAN_MACROS=false

# --- mail routing ---
MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day
RELAYNETS=
RELAYHOST=
RECIPIENT_DELIMITER=+
REJECT_UNLISTED_RECIPIENT=no
DEFAULT_SPAM_THRESHOLD=80

# --- DKIM / rspamd ---
DKIM_SELECTOR=dkim
DKIM_DOMAIN=example.com
DKIM_KEY_LENGTH=2048
RSPAMD_PASSWORD=change-me-rspamd
FILTER_SIEVE=true
FILTER_SPAMASSASSIN=false
FILTER_CLAMAV=false
FILTER_DKIM_CHECK=true
FILTER_DKIM_SIGN=true
FULL_TEXT_SEARCH=en

# --- fetchmail ---
FETCHMAIL_ENABLED=False
FETCHMAIL_DELAY=600

# --- misc ---
CREDENTIAL_ROUNDS=12
DISABLE_STATISTICS=True
LOG_LEVEL=INFO
# RESOLVER_ADDRESS is intentionally unset: the nginx front resolves its
# upstreams ($backend=host.docker.internal, mail-filter, mta/mail-store) via Docker's
# embedded DNS (127.0.0.11). Pointing it at the unbound container would make
# those lookups NXDOMAIN. The unbound container (192.168.206.254) remains
# available for components that opt into it via their own DNS config.

# ManageSieve endpoint used by the webmail filter editor (routed through the
# front nginx proxy; authenticated with the per-session temp token)
MAIL_SIEVE_ADDR=front:4190
