# Shared environment for the mailez mail images (gateway / mailezine / macro-scanner)
# and the mailezine engine. The mailez backend is the control plane: the
# images call its internal API at http://MAILEZ_BACKEND_ADDRESS:8080.
# The images hardcode port 8080, so the backend must listen on 8080 inside the
# docker network (the published host port is mapped separately in
# docker-compose.yml).

# --- control plane wiring ---
MAILEZ_BACKEND_ADDRESS=backend
# TokenEnc / 外部账号密码的加密密钥(16 字节)。生产部署必须更换:
#   openssl rand -hex 16
MAILEZ_SECRET_KEY=change-me-please-16-bytes

# --- 内部 /stack API 共享密钥(所有 compose 档必填) ---
# mailezine 引擎与 backend 之间的内部回调(认证/目录/DKIM vault/外部账号
# 密码读取)走共享密钥鉴权。两行必须同值;compose 的 ${MAILEZ_STACK_SECRET:?}
# 插值要求非空(留空无法启动生产/社区 compose 档——这正是防止内部 API
# 裸奔的保护:同网络任何容器都能读取 DKIM 私钥与外部邮箱明文密码)。
# 同值还充当引擎管理 API(8090)的 Bearer secret:backend 删除用户时经
# MAIL_ENGINE_MGMT_SECRET 级联清除引擎侧邮箱数据(两个 compose 文件都
# 引用 MAILEZ_STACK_SECRET,无需重复设置)。
# 生成:openssl rand -hex 32
MAILEZ_STACK_SECRET=
MAILEZINE_STACK_SECRET=

# --- 控制面数据库（ce 默认 SQLite，零外部依赖） ---
# 留空即 SQLite（./data/mailez.db，随数据目录整体备份）。可选 MySQL /
# PostgreSQL，并配合 docker-compose.ce.yml 的 --profile mysql / postgres：
#   MAILEZ_DB_DRIVER=mysql
#   MAILEZ_DB_DSN=mailez:mailez@tcp(mysql:3306)/mailez?charset=utf8mb4&parseTime=True&loc=Local
#   MAILEZ_DB_DRIVER=postgres
#   MAILEZ_DB_DSN=postgres://mailez:mailez@postgres:5432/mailez?sslmode=disable
# MAILEZ_DB_DRIVER=sqlite

# --- release image tag / registry ---
# Tag for all mailez images (13 package names, see docker-bake.hcl).
# Production deployments pull; pin a release here for controlled upgrades:
#   MAILEZ_IMAGE_TAG=v1.0.0
# (leave unset to track :latest). Local source builds ignore this and use
# :local automatically:
#   MAILEZ_LOCAL_BUILD=1 ./mailezctl.sh up ce
# MAILEZ_IMAGE_TAG=v1.0.0
# Registry override (default ghcr.io/mailez-hq), e.g. for a mirror:
# MAILEZ_REGISTRY=ghcr.io/mailez-hq
# Pin the mailezine engine image separately (e.g. engine and control plane
# releasing apart); unset tracks MAILEZ_IMAGE_TAG:
# MAILEZINE_IMAGE_TAG=v1.0.0
MAILEZ_SUBNET6=

# --- identity ---
MAILEZ_DOMAIN=example.com
MAILEZ_HOSTNAMES=mail.example.com
MAILEZ_POSTMASTER=postmaster
TZ=Etc/UTC
COMPOSE_PROJECT_NAME=mailez

# --- docker 网络 ---
# 邮件栈 compose 使用固定私有网段（受信网段：引擎 TRUSTED_NETS 与
# gateway 代理信任共用）。默认 192.168.206.0/24，
# 如需改网段，必须同时导出同名变量给 compose 插值：
#   $env:MAILEZ_SUBNET = "10.20.30.0/24"
# 容器间一律走服务名（Docker DNS），不再依赖固定容器 IP。
MAILEZ_SUBNET=192.168.206.0/24

# --- TLS ---
# off: plaintext only (local dev)
# cert: provide cert.pem / key.pem in ./certs (see deploy/certs/README.md)
# letsencrypt: automated ACME (needs exposed 80/443)
MAILEZ_TLS=off
# MAILEZ_TLS_CERT_FILE=cert.pem
# MAILEZ_TLS_KEY_FILE=key.pem
MAILEZ_TLS_PORTS=80,443
# 引擎侧隐式 TLS（465/993/995）与 STARTTLS 用同一套证书；letsencrypt 模式下
# 网关把证书写到 ./certs/letsencrypt/live/mailez/，直接引用即可：
# MAILEZINE_TLS_CERT_FILE=/certs/letsencrypt/live/mailez/nginx-chain.pem
# MAILEZINE_TLS_KEY_FILE=/certs/letsencrypt/live/mailez/privkey.pem

# --- 对外绑定地址 ---
# 控制台/API（8081-8083）默认只绑本机：管理台与 Webmail 走网关
# （https://<主机名>/admin 与 /），8082/8083 仅作调试直连。想让它们
# 直接对外时改 MAILEZ_BIND，不必改 compose。
#
# 邮件协议默认对外（25/465/587/143/993/110/995/4190 需要接收外部邮件）；
# 评估实例想只用本机时设成 127.0.0.1。
# MAILEZ_BIND=127.0.0.1
# MAILEZ_MAIL_BIND=0.0.0.0

# --- features ---
MAILEZ_API=true
MAILEZ_ANTIVIRUS=none
MAILEZ_SCAN_MACROS=false
MAILEZ_GREYLISTING=false

# --- mail routing ---
MAILEZ_MESSAGE_SIZE_LIMIT=50000000
MAILEZ_MESSAGE_RATELIMIT=200
MAILEZ_RELAYNETS=
MAILEZ_RECIPIENT_DELIMITER=+

# --- DKIM / full-text search ---
MAILEZ_DKIM_SELECTOR=dkim
# 全文检索由引擎侧 MAILEZINE_FTS_ENABLED 控制（默认开）。

# --- SSO（OIDC 联合登录，可选） ---
# 配置后 webmail/admin 登录页出现"统一身份登录"入口：跳转 IdP 授权、
# 回调后按 email 匹配本地已启用账号（不自动开户），成功即建会话。
# RedirectURL 留空时自动推导为 https://<站点域名>/api/v1/sso/oidc/callback，
# 该地址需在 IdP 处登记为重定向 URI。四项全部配置才会启用。
# MAILEZ_OIDC_ISSUER=https://idp.example.com
# MAILEZ_OIDC_CLIENT_ID=mailez
# MAILEZ_OIDC_CLIENT_SECRET=change-me
# MAILEZ_OIDC_REDIRECT_URL=

# --- 运维告警 / 登录封禁 / 加密备份（v1.0.1 新增，全部可选） ---
# 变更式健康告警：后台按 MAILEZ_HEALTH_ALERT_INTERVAL_MIN 分钟重跑健康
# 检查，只在状态发生变化时通知——首轮只记基线，状态须连续两次巡检一致
# 才推送，恢复同样通知。送达管理员邮箱；配了 WEBHOOK 就同时推 JSON
# （Slack / 钉钉 / 企业微信兼容）。MUTE 静音单个检查项，逗号分隔，键为
# system:<id> 或 domain:<域名>:<id>；MAILEZ_HEALTH_ALERT=off 整体关闭。
# MAILEZ_HEALTH_ALERT=on
# MAILEZ_HEALTH_ALERT_INTERVAL_MIN=60
# MAILEZ_HEALTH_ALERT_WEBHOOK=https://example.com/hooks/mailez
# MAILEZ_HEALTH_ALERT_MUTE=system:cert,domain:example.com:dkim
#
# 出站网络体检的探测目标：默认拨测 aspmx.l.google.com:25，用来确认本机
# 到底能不能向外投递（云厂商封 25 端口时其余检查全是绿的）；想换成自建
# 中继或别的 MTA 时设这里。
# MAILEZ_OUTBOUND_PROBE_HOST=
#
# 登录封禁：MAILEZ_BAN_FINDTIME_SEC 秒内认证失败 MAILEZ_BAN_MAX_RETRY 次
# 即封禁来源 IP（Web 登录与邮件代理 SASL 共用同一套计数），时长按 30 天
# 内累犯从 15 分钟递增到 24 小时。回环地址与本部署自身地址始终豁免；
# 办公出口、监控探针网段请加白名单（CIDR 逗号分隔），否则会被自己封掉。
# MAILEZ_BAN_MAX_RETRY=20
# MAILEZ_BAN_FINDTIME_SEC=600
# MAILEZ_BAN_WHITELIST=203.0.113.0/24,198.51.100.7
#
# 定时加密备份：控制面 SQLite VACUUM INTO 快照 + 附件/云盘目录，分块
# AES-256-GCM 加密后投递。没配 MAILEZ_BACKUP_KEY 就完全不跑（也不会产生
# 明文归档），健康中心会把备份新鲜度评为失败（>7 天告警、>14 天失败）。
# TARGET 为 local:<目录> 或 s3；本地目录要落在挂载卷里（容器内 /data 即
# 宿主的 deploy/data/），否则归档只存在容器可写层、重建即丢。s3 复用引擎
# 侧的 MAILEZINE_S3_ENDPOINT / _ACCESS_KEY / _SECRET_KEY / _BUCKET /
# _USE_SSL 一组变量。
# MAILEZ_BACKUP_KEY=
# MAILEZ_BACKUP_TARGET=local:/data/backups
# MAILEZ_BACKUP_KEEP=14
# MAILEZ_BACKUP_HOUR=3
#
# 单个附件大小上限（字节）。Webmail 的上传选择器按 20MB 拦，但 API 可以
# 直接调用、网关只限制整个请求体，所以服务端也要挡一道；超限返回 422
# attachment_too_large。设 0 关闭该检查。
# MAILEZ_MAX_ATTACHMENT_BYTES=20971520

# --- misc ---
LOG_LEVEL=info
# MAILEZ_RESOLVER_ADDRESS is intentionally unset: the nginx gateway resolves
# its upstreams (backend, mail-filter, mailezine) via Docker's embedded
# DNS (127.0.0.11). Pointing it at the unbound container would make those
# lookups NXDOMAIN. The unbound container (service name "resolver") remains
# available for components that opt into it via their own DNS config.

# ManageSieve endpoint used by the webmail filter editor (the mailezine
# engine's ManageSieve port; authenticated with the per-session temp token)
MAIL_SIEVE_ADDR=mailezine:4190

# --- 引擎内置基础反垃圾（internal/junk；配置 MAILEZINE_RSPAMD_URL 后自动让位：
# 内置 rspamd 扫描） ---
# MAILEZINE_JUNK_ENABLED=true
# MAILEZINE_JUNK_HEADER_SCORE=4.5
# MAILEZINE_JUNK_REJECT_SCORE=12
# MAILEZINE_JUNK_RBLS=bl.spamcop.net
# MAILEZINE_JUNK_WHITELIST=partner.example,boss@corp.example
# MAILEZINE_JUNK_BLACKLIST=@spam.example
# MAILEZINE_JUNK_GREYLIST=false
# --- 宿主端口映射（默认值见下；被占用时改这里，compose 插值自动生效） ---
# MAILEZ_HTTP_PORT=80
# MAILEZ_HTTPS_PORT=443
# MAILEZ_ADMIN_PORT=8082
# MAILEZ_WEBMAIL_PORT=8083
# MAILEZ_API_PORT=8081
