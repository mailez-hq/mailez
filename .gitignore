# Go
backend/bin/
backend/*.exe
*.log

# Node
node_modules/
**/*.old
.pnpm-store/
.next/
out/
dist/
*.tsbuildinfo

# Env
.env
.env.local
deploy/*.env
deploy/*.env.bench.bak

# TLS certificates (local, never commit; keep the docs)
deploy/certs/*
!deploy/certs/README.md

# Legacy stack backup — contains private keys and HSM blobs, never commit
deploy/.backup-legacy/

# Runtime license files (per-deployment, issued at install time)
deploy/licenses/

# Data (local dev persistence)
data/
*.db
*.db-journal

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Edition modules materialized by scripts/set-edition.mjs (build artifact)
frontend/apps/*/edition/

# Local CE mirror exports (private export tooling output)
build/
